generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  STUDENT
}

enum SessionRevokedReason {
  REPLACED
  REVOKED
}

enum MaterialStatus {
  DRAFT
  REVIEWED
  PUBLISHED
}

model User {
  id                 String     @id @default(cuid())
  role               Role
  username           String?    @unique
  passwordHash       String?
  mustChangePassword Boolean    @default(false)
  displayName        String
  loginName          String?
  nis                String?    @unique
  classId            String?
  class              Class?     @relation(fields: [classId], references: [id])
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  sessions           Session[]
  auditLogs          AuditLog[]
  materialsCreated   Material[] @relation("MaterialCreatedBy")
  materialsUpdated   Material[] @relation("MaterialUpdatedBy")
  imagesCreated      Image[]

  @@unique([classId, loginName])
  @@index([classId])
}

model Class {
  id            String   @id @default(cuid())
  name          String   @unique
  code          String   @unique
  codeRotatedAt DateTime @default(now()) @db.Timestamptz(3)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  users         User[]
}

model Session {
  id            String                @id @default(cuid())
  tokenHash     String                @unique
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime              @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  revokedAt     DateTime?             @db.Timestamptz(3)
  revokedReason SessionRevokedReason?

  @@index([userId])
}

model LoginThrottle {
  key             String   @id
  failCount       Int
  windowStartedAt DateTime @db.Timestamptz(3)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Subject {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  chapters    Chapter[]
}

model Chapter {
  id                  String        @id @default(cuid())
  subjectId           String
  subject             Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  title               String
  order               Int
  sourceBook          String
  sourceYearOrEdition String
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  subchapters         Subchapter[]
  materials           Material[]

  @@unique([subjectId, order])
}

model Subchapter {
  id          String     @id @default(cuid())
  chapterId   String
  chapter     Chapter    @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  title       String
  order       Int
  sourcePages String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  materials   Material[]

  @@unique([chapterId, order])
  @@unique([id, chapterId])
}

model Material {
  id              String         @id @default(cuid())
  chapterId       String
  chapter         Chapter        @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  subchapterId    String?
  subchapter      Subchapter?    @relation(fields: [subchapterId, chapterId], references: [id, chapterId], onDelete: Restrict)
  title           String
  summary         String
  content         String
  examples        String?
  exercises       String?
  sourceReference String
  sourcePages     String?
  status          MaterialStatus @default(DRAFT)
  order           Int
  createdById     String
  createdBy       User           @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById     String
  updatedBy       User           @relation("MaterialUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  publishedAt     DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  images          Image[]

  @@index([chapterId, status, order])
}

model Image {
  id              String   @id @default(cuid())
  materialId      String
  material        Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  storageKey      String   @unique
  mimeType        String
  sizeBytes       Int
  width           Int
  height          Int
  altText         String
  caption         String?
  sourceReference String?
  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([materialId])
}
