# Runtime (Neon: pakai URL pooled, host berakhiran -pooler). Lokal: Docker.
DATABASE_URL=postgresql://aksara:aksara@localhost:5433/aksara_dev
# Migrasi (Neon: pakai URL direct, tanpa -pooler).
DIRECT_URL=postgresql://aksara:aksara@localhost:5433/aksara_dev

# Akun guru untuk seed
TEACHER_USERNAME=
TEACHER_PASSWORD=
